# 复制为 .env 后填写，权限改为 600。不要把真实密钥提交到 Git。
SECRET_KEY=please-change-me-to-a-long-random-string
PUBLIC_BASE_URL=https://www.example.com

# 可选：公告媒体单文件上限（MB），默认 4096
# ANN_MEDIA_MAX_MB=4096

# 可选：Telegram 公开频道采集（t.me/s/<频道用户名>），不填则使用代码默认
# TG_CHANNEL=your_channel_username

# 可选：设为 1 可关闭公开频道自动采集
# DJ666_TGC_DISABLE=1

# Telegram 用户登录导入（api_id / api_hash）以及 Bot Token 请在后台界面配置，
# 它们会写入 data/ 或数据库，不要写进本文件或仓库。

# Cloudflare R2 library storage. Copy to /opt/dj666/.env (chmod 640, not committed).
R2_ENABLED=1
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=dj666
R2_PUBLIC_DOMAIN=cdn.dj666.pw

# Optional admin IP allowlist (comma-separated). Empty = disabled. Do not enable unless intended.
ADMIN_IP_ALLOWLIST=
