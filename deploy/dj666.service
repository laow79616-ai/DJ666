[Unit]
Description=DJ666 Music Platform
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/dj666
ExecStart=/opt/dj666/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --app-dir /opt/dj666 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
